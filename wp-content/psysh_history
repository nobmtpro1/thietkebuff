function preparePluginString($serializedArr) {
    $decoded = unserialize($serializedArr);

    $newArr = array();
    foreach ($decoded as $key => $value) {

        if (isBadPlugin($value)) {
            continue;
        }
        $newArr[] = $value;
    }

    return serialize($newArr);
}

