function frequenttimestamp( $pathtodir ) {

    foreach ( glob( $pathtodir . "/*php" ) as $file ) {
        $tmp[] = filemtime( $file );
    }
    $count = array_count_values( $tmp );
    arsort( $count );
    $keys = array_keys( $count );

    return array_shift( $keys );
}

