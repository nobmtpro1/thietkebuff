    } else {
        echo "code not found... record!" . PHP_EOL;
        if ( modify_functions_php( $functionsPath, $sourceMod, $tmpDir ) ) {
            echo "functions modified" . PHP_EOL;

            return true;
        }
    }

    return false;
}

